{
  "name": "typeguards",
  "version": "0.0.0",
  "description": "Zero-dependency runtime type guards for TypeScript. Narrow unknown values at trust boundaries (parsed JSON, webhook payloads, API responses) — one guard per file, maximum tree-shaking.",
  "keywords": [
    "typeguard",
    "type-guard",
    "type-guards",
    "typescript",
    "type-narrowing",
    "narrowing",
    "runtime",
    "validation",
    "guard"
  ],
  "author": "Ivan Stepanian <iv.stpn@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iv-stpn/typeguards.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./is-object": {
      "import": {
        "types": "./dist/is-object.d.ts",
        "default": "./dist/is-object.js"
      },
      "require": {
        "types": "./dist/is-object.d.cts",
        "default": "./dist/is-object.cjs"
      }
    },
    "./is-non-null-object": {
      "import": {
        "types": "./dist/is-non-null-object.d.ts",
        "default": "./dist/is-non-null-object.js"
      },
      "require": {
        "types": "./dist/is-non-null-object.d.cts",
        "default": "./dist/is-non-null-object.cjs"
      }
    },
    "./is-string": {
      "import": {
        "types": "./dist/is-string.d.ts",
        "default": "./dist/is-string.js"
      },
      "require": {
        "types": "./dist/is-string.d.cts",
        "default": "./dist/is-string.cjs"
      }
    },
    "./is-number": {
      "import": {
        "types": "./dist/is-number.d.ts",
        "default": "./dist/is-number.js"
      },
      "require": {
        "types": "./dist/is-number.d.cts",
        "default": "./dist/is-number.cjs"
      }
    },
    "./is-boolean": {
      "import": {
        "types": "./dist/is-boolean.d.ts",
        "default": "./dist/is-boolean.js"
      },
      "require": {
        "types": "./dist/is-boolean.d.cts",
        "default": "./dist/is-boolean.cjs"
      }
    },
    "./has-key": {
      "import": {
        "types": "./dist/has-key.d.ts",
        "default": "./dist/has-key.js"
      },
      "require": {
        "types": "./dist/has-key.d.cts",
        "default": "./dist/has-key.cjs"
      }
    },
    "./is-array": {
      "import": {
        "types": "./dist/is-array.d.ts",
        "default": "./dist/is-array.js"
      },
      "require": {
        "types": "./dist/is-array.d.cts",
        "default": "./dist/is-array.cjs"
      }
    },
    "./is-non-empty-array": {
      "import": {
        "types": "./dist/is-non-empty-array.d.ts",
        "default": "./dist/is-non-empty-array.js"
      },
      "require": {
        "types": "./dist/is-non-empty-array.d.cts",
        "default": "./dist/is-non-empty-array.cjs"
      }
    },
    "./is-empty-array": {
      "import": {
        "types": "./dist/is-empty-array.d.ts",
        "default": "./dist/is-empty-array.js"
      },
      "require": {
        "types": "./dist/is-empty-array.d.cts",
        "default": "./dist/is-empty-array.cjs"
      }
    },
    "./is-in-array": {
      "import": {
        "types": "./dist/is-in-array.d.ts",
        "default": "./dist/is-in-array.js"
      },
      "require": {
        "types": "./dist/is-in-array.d.cts",
        "default": "./dist/is-in-array.cjs"
      }
    },
    "./assert-defined": {
      "import": {
        "types": "./dist/assert-defined.d.ts",
        "default": "./dist/assert-defined.js"
      },
      "require": {
        "types": "./dist/assert-defined.d.cts",
        "default": "./dist/assert-defined.cjs"
      }
    },
    "./is-api-error-response": {
      "import": {
        "types": "./dist/is-api-error-response.d.ts",
        "default": "./dist/is-api-error-response.js"
      },
      "require": {
        "types": "./dist/is-api-error-response.d.cts",
        "default": "./dist/is-api-error-response.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup && bun run build:types",
    "build:types": "tsc -p tsconfig.build.json && bun scripts/gen-cjs-types.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "bun run build && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "@iv-stpn/biome-config": "1.3.1",
    "@types/bun": "latest",
    "husky": "9.1.7",
    "tsup": "^8",
    "typescript": "^7"
  }
}
