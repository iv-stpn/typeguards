    "typeguard",
    "type-guard",
    "type-guards",
    "typescript",
    "type-narrowing",
    "narrowing",
    "runtime",
    "validation",
    "guard"
  ],
  "author": "Ivan Stepanian <iv.stpn@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iv-stpn/typeguards.git"
  },
