  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup && bun run build:types",
    "build:types": "tsc -p tsconfig.build.json && bun scripts/gen-cjs-types.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test && bun run check-coverage",
    "check-coverage": "bun scripts/coverage.ts check",
    "badge:coverage": "bun test && bun scripts/coverage.ts badge",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "docs": "node --import ./scripts/typedoc-ts6-hook.mjs ./node_modules/typedoc/dist/cli.js --options typedoc.json",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "bun run build && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "@iv-stpn/biome-config": "1.3.1",
    "@types/bun": "latest",
    "@typescript/typescript6": "6.0.2",
    "husky": "9.1.7",
    "tsup": "^8",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.12.0",
    "typescript": "^7"
